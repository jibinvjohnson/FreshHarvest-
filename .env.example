# ==============================================================================
# FreshHarvest — Environment Configuration
# Copy this file to .env.local to configure your environment.
# ==============================================================================

# Next.js Port (Default 3000)
PORT=3000

# Supabase Configuration (Optional for remote PostgreSQL connection)
# If provided, the application connects to Supabase PostgreSQL database.
# If omitted, FreshHarvest automatically runs in High-Fidelity Local Development Mode
# backed by an in-memory/file relational engine that mirrors all schema constraints.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct PostgreSQL Connection String (Optional for pg driver)
# postgres://username:password@localhost:5432/local_farmer_market
DATABASE_URL=
